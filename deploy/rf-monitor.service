[Unit]
Description=RF monitor (Orange Pi + SA6 + RODOS)
After=network-online.target
Wants=network-online.target

[Service]
User=orangepi
SupplementaryGroups=dialout
WorkingDirectory=/opt/rf-monitor
Environment=SA6_PORT=/dev/ttyACM0
Environment=RODOS_IP=192.168.1.20
Environment=RF_DATA_DIR=/opt/rf-monitor/data
ExecStart=/opt/rf-monitor/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
